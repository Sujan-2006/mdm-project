<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8FA">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#0D1B3E"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="14dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF"
            android:contentDescription="Back"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:text="App Inventory"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvResultCount"
                android:text="Loading..."
                android:textSize="11sp"
                android:textColor="#6B7FA8"
                android:fontFamily="monospace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminateTint="#FFFFFF"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- STATS ROW -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Total -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/stat_card_blue"
            android:padding="10dp"
            android:layout_marginEnd="6dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tvTotalCount"
                android:text="—"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#0C447C"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="Total"
                android:textSize="10sp"
                android:textColor="#378ADD"
                android:letterSpacing="0.04"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <!-- System -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/stat_card_green"
            android:padding="10dp"
            android:layout_marginEnd="6dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tvSystemCount"
                android:text="—"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#27500A"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="System"
                android:textSize="10sp"
                android:textColor="#639922"
                android:letterSpacing="0.04"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <!-- User -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/stat_card_purple"
            android:padding="10dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tvUserCount"
                android:text="—"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#3C3489"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="User"
                android:textSize="10sp"
                android:textColor="#7F77DD"
                android:letterSpacing="0.04"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

    </LinearLayout>

    <!-- SEARCH + FILTER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:paddingTop="4dp">

        <!-- Search -->
        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="Search app name or package..."
            android:textSize="13sp"
            android:textColor="#0D1B3E"
            android:textColorHint="#94A3B8"
            android:background="@drawable/input_background"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:fontFamily="monospace"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:layout_marginBottom="10dp"/>

        <!-- Filter Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAll"
                android:text="All"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#0D1B3E"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>

            <Button
                android:id="@+id/btnUser"
                android:text="User"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:textSize="12sp"
                android:backgroundTint="#EEEDFE"
                android:textColor="#534AB7"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>

            <Button
                android:id="@+id/btnSystem"
                android:text="System"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:textSize="12sp"
                android:backgroundTint="#EAF3DE"
                android:textColor="#3B6D11"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- DIVIDER -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0"/>

    <!-- LOADING TEXT -->
    <TextView
        android:id="@+id/tvLoading"
        android:text="Loading apps..."
        android:textSize="13sp"
        android:textColor="#94A3B8"
        android:fontFamily="monospace"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"/>

    <!-- APP LIST -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F7F8FA"
        android:clipToPadding="false"
        android:paddingBottom="8dp"/>

</LinearLayout>